# Copy this file to .env.local and fill in the values.
#
# AUTH_SECRET: random 32-byte base64 string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth client credentials. Get them at:
#   https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID of type "Web application" and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Allowed Workspace domain. The signed `hd` claim of the Google ID token must match this.
ALLOWED_HD=stuba.sk

# Comma-separated list of @stuba.sk emails granted admin role on login.
# Everyone else gets role=student.
ADMIN_EMAILS=

